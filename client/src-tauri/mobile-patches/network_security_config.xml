<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to gen/android/app/src/main/res/xml/network_security_config.xml
  after `tauri android init`, then reference it from AndroidManifest.xml:

    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

  Needed because a self-hosted backend is usually plain HTTP on the LAN
  (Android 9+ blocks cleartext traffic by default).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
    </domain-config>
</network-security-config>
