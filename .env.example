# 家务小当家 Environment Variables
# Copy this file to .env and fill in your values

# Copy to .env — the server picks it up automatically on startup, in any shell.
# Variables already set in the real environment (Docker / CI / shell exports)
# take precedence over this file.

# Server Configuration
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai

# Security - REQUIRED in production
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Database (handled by Docker volume, no config needed)
# Database file: ./data/jiawu.db
